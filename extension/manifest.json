{
  "manifest_version": 3,
  "name": "Arena Transcript Export",
  "version": "0.2.1",
  "description": "Export the current Arena.ai agent branch to Markdown: full history force-loaded, all spoilers (reasoning, tool runs) expanded.",
  "permissions": [
    "downloads",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://arena.ai/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Export Arena transcript to Markdown",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://arena.ai/agent/*"
      ],
      "run_at": "document_idle",
      "js": [
        "content/selectors.js",
        "content/util.js",
        "content/markdown.js",
        "content/serialize.js",
        "content/loader.js",
        "content/expand.js",
        "content/main.js"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}